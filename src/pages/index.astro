---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Agenda from "../components/Agenda.jsx";
import CarteSection from "../components/CarteSection.jsx";
import LesIncontournables from "../components/LesIncontournables.jsx";
import Sejourner from "../components/Sejourner.jsx";
import InformationsPratiques from "../components/InformationsPratiques.jsx";
import GuidesNumeriques from "../components/GuidesNumeriques.jsx";
import Footer from "../components/Footer.jsx";
import LesPlages from "../components/LesPlages";
import ActiviteLoisir from "../components/ActiviteLoisir";
import DecouvreTerritoire from "../components/DecouvreTerritoire";
import ArtisanatTerroirReal from "../components/ArtisanatTerroirReal";
import { type RootGlobal } from "../types/gloabal";
import { type RootLandingPage } from "../types/landingpage";
import { fetchSites, transformSiteData } from "../services/sitesService.js";

import { PUBLIC_API_URL } from "astro:env/client";
import {
  fetchAllEvenements,
  fetchAllSejourners,
  fetchAllPlages,
  fetchAllArtisanat,
  fetchAllRandonnees,
  fetchAllActivitesNautiques,
  fetchColorTexte,
} from "../services/apiUtils.js";
import type { RootEvenements } from "../types/evenements";
import type { RootSejourner } from "../types/sejourner";
import type { RootPlage } from "../types/plages";
import type { RootartisanatEtProduit } from "../types/artisanat-et-produit";
import type { RootRandonnee } from "../types/randonnee";
import type { RootActiviteNautique } from "../types/activite-nautique";
import type { RootSite } from "../types/site";
import type { RootSitePhare } from "../types/site-phare";
import type { RootColorTexte } from "../types/color-texte";
import { generateCSSVariables } from "../utils/colorUtils.js";

// console.log("API URL:", PUBLIC_API_URL);

// Récupération des couleurs dynamiques
const colorData: RootColorTexte = await fetchColorTexte();
// console.log("Color Data:", colorData);

// On utilise maintenant des fetchAll pour récupérer 100% des entrées.
// ---- fetch Global
const data = await fetch(`${PUBLIC_API_URL}/api/global`, {
  method: "GET",
  headers: {
    "Content-Type": "application/json",
  },
});

const globalData: RootGlobal = await data.json();
// console.log("Global Data:", globalData);

// fetch landing-page

const dataLandingPage = await fetch(`${PUBLIC_API_URL}/api/landing-page`, {
  method: "GET",
  headers: {
    "Content-Type": "application/json",
  },
});

const dataLandingPageJson: RootLandingPage = await dataLandingPage.json();
// console.log("dataLandingPageJson Data:", dataLandingPageJson);

// fetch evenements

const dataEvenementsJson: RootEvenements = await fetchAllEvenements({
  populate: "*",
});
// console.log("dataEvenementsJson Data:", dataEvenementsJson);

// fecth sejourner

const dataSejournerJson: RootSejourner = await fetchAllSejourners({
  populate: "*",
});
// console.log("dataSejournerJson Data:", dataSejournerJson);

// fetch plages

const dataPlagesJson: RootPlage = await fetchAllPlages({ populate: "*" });
// console.log("dataPlagesJson Data:", dataPlagesJson);

// fetch artisanat-et-produit
const dataArtisanatEtProduitJson: RootartisanatEtProduit =
  await fetchAllArtisanat({ populate: "*" });
// console.log("dataArtisanatEtProduitJson Data:", dataArtisanatEtProduitJson);

// Randonnees

const dataRandonneesJson: RootRandonnee = await fetchAllRandonnees({
  populate: "*",
});
// console.log("dataRandonneesJson Data:", dataRandonneesJson);

// activites-nautiques

const dataActiviteNautiqueJson: RootActiviteNautique =
  await fetchAllActivitesNautiques({ populate: "*" });
// console.log("dataActiviteNautiqueJson Data:", dataActiviteNautiqueJson);

// fetch sites phares (nouvelle route)
const sitePharesRes = await fetch(
  `${PUBLIC_API_URL}/api/site-phares?populate=*`
);
let sites = [];
if (sitePharesRes.ok) {
  const sitePharesData: RootSitePhare = await sitePharesRes.json();
  sites = sitePharesData.data.map((item) => {
    const img = item.site?.Images?.[0];
    const sized = img?.formats?.medium || img?.formats?.small || img;
    return {
      slug: item.site?.documentId || item.site?.id,
      title: item.site?.Titre,
      image: sized ? `${PUBLIC_API_URL}${sized.url || img?.url}` : undefined,
      subtitle: item.site?.Description?.slice(0, 80) || "",
    };
  });
} else {
  // fallback sur sites existants si la route échoue
  const sitesData = await fetchSites();
  sites = sitesData.data.map(transformSiteData).map((s) => ({
    slug: s.slug,
    title: s.title,
    image: s.image,
    subtitle: s.subtitle || s.commune || "",
  }));
}
// console.log("Sites Phares Data:", sites);
---

<Layout
  title="Tourisme en Castagniccia-Casinca | Découvrez la Corse authentique"
  description="Explorez la Castagniccia-Casinca en Haute-Corse : villages pittoresques, randonnées nature, patrimoine historique, plages sauvages, gastronomie locale et hébergements de charme. Votre guide touristique officiel."
  keywords="Castagniccia Casinca Corse, tourisme Haute-Corse, villages corses authentiques, randonnées Corse, patrimoine corse, plages Corse orientale, gastronomie corse, hébergements Corse"
  pageCategory="Accueil"
  pageName="accueil"
  type="website"
  image="/photos/Mont-San-Petrone.jpg"
>
  <Hero data={dataLandingPageJson.data.Hero} colorData={colorData} />
  <Agenda
    data={dataLandingPageJson.data.Agenda}
    events={dataEvenementsJson.data}
    colorData={colorData}
    client:load
  />
  <CarteSection
    data={dataLandingPageJson.data.CarteInteractive}
    colorData={colorData}
  />
  <LesIncontournables
    data={dataLandingPageJson.data.LesIncontournables}
    sites={sites}
    colorData={colorData}
    client:load
  />
  <DecouvreTerritoire
    data={dataLandingPageJson.data.DecouvrezLeTerritoire}
    colorData={colorData}
  />
  <Sejourner
    data={dataLandingPageJson.data.Sejourner}
    sejourners={dataSejournerJson.data}
    colorData={colorData}
  />
  <LesPlages
    data={dataLandingPageJson.data.LesPlages}
    plages={dataPlagesJson.data}
    colorData={colorData}
  />
  <ArtisanatTerroirReal
    data={dataLandingPageJson.data.ArtisanatEtProduitsDuTerroir}
    artisanat={dataArtisanatEtProduitJson.data}
    colorData={colorData}
  />
  <ActiviteLoisir
    data={dataLandingPageJson.data.ActiviteLoisir}
    randonnees={dataRandonneesJson.data}
    activitesNautiques={dataActiviteNautiqueJson.data}
    colorData={colorData}
  />
  <GuidesNumeriques
    data={dataLandingPageJson.data.guideSections}
    colorData={colorData}
  />

  <InformationsPratiques
    data={dataLandingPageJson.data.InformationsPratiques}
    colorData={colorData}
  />
  <Footer data={globalData} />
</Layout>
