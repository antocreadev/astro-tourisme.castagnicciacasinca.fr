---
import Layout from "../layouts/Layout.astro";
import GuidesNumeriques from "../components/GuidesNumeriques.jsx";
import { PUBLIC_API_URL } from "astro:env/client";

// Récupération des données de la landing page pour obtenir les guides
const dataLandingPage = await fetch(`${PUBLIC_API_URL}/api/landing-page`, {
  method: "GET",
  headers: {
    "Content-Type": "application/json",
  },
});

const dataLandingPageJson = await dataLandingPage.json();

// Données pour la page guides avec titre et description personnalisés
const guidesData = {
  ...dataLandingPageJson.data.guideSections,
  Titre: "Guides numériques",
  Description:
    "Découvrez nos guides numériques interactifs pour explorer le territoire de la Castagniccia-Casinca. Des ressources complètes pour préparer votre visite et découvrir toutes les richesses de notre région.",
};
---

<Layout
  title="Guides numériques - Tourisme Castagniccia-Casinca"
  pageCategory="Guides"
  pageName="guides"
>
  <div class="pt-20 sm:pt-24">
    <GuidesNumeriques data={guidesData} />

    {/* Section complémentaire */}
    <div class="bg-white py-16 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-black mb-6">
          Des ressources pour tous
        </h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-8">
          Nos guides numériques sont conçus pour vous accompagner dans la
          découverte de notre territoire. Que vous soyez en famille, entre amis,
          ou en solo, trouvez toutes les informations nécessaires pour vivre une
          expérience inoubliable en Castagniccia-Casinca.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12">
          <div class="text-center">
            <div
              class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-green-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C20.832 18.477 19.246 18 17.5 18c-1.746 0-3.332.477-4.5 1.253"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-black mb-2">
              Guides interactifs
            </h3>
            <p class="text-gray-600">
              Naviguez facilement avec nos guides numériques enrichis
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-black mb-2">
              Informations pratiques
            </h3>
            <p class="text-gray-600">
              Tous les conseils pour organiser votre séjour
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-orange-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-black mb-2">
              Géolocalisation
            </h3>
            <p class="text-gray-600">
              Trouvez facilement votre chemin vers nos sites
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
