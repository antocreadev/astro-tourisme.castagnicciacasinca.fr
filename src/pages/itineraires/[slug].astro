---
import Layout from "../../layouts/Layout.astro";
import ItineraireDetail from "../../components/detail/ItineraireDetail.jsx";
import { itineraires } from "../../data/itineraires.js";

export async function getStaticPaths() {
  return itineraires.map((itineraire) => ({
    params: { slug: itineraire.slug },
    props: { itineraire },
  }));
}

const { itineraire } = Astro.props;
---

<Layout
  title={`${itineraire.title} - Itinéraires`}
  description={itineraire.description ||
    `Découvrez l'itinéraire ${itineraire.title} en Castagniccia-Casinca.`}
  pageCategory="itineraire"
  pageName={itineraire.title}
>
  <ItineraireDetail itineraire={itineraire} client:load />
</Layout>
