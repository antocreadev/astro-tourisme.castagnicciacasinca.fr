---
import Layout from "../../layouts/Layout.astro";
import RandonneeListing from "../../components/listing/RandonneeListing.jsx";
import { PUBLIC_API_URL } from "astro:env/client";
import {
  fetchAllRandonnees,
  fetchColorTexte,
} from "../../services/apiUtils.js";
import type { RootRandonnee } from "../../types/randonnee";
import type { RootColorTexte } from "../../types/color-texte";
import type { RootTextePageSecondaire } from "../../types/texte-page-secondaire";

// Récupération des couleurs dynamiques
const colorData: RootColorTexte = await fetchColorTexte();

// Fetch randonnees (toutes pages)
const randonneesData: RootRandonnee = await fetchAllRandonnees({
  populate: "*",
});

// Récupération du texte de la page
const pageTextsResponse = await fetch(`${PUBLIC_API_URL}/api/texte-page-secondaire?filters[page][$eq]=randonnee&populate=*`);
const pageTextsData: RootTextePageSecondaire = await pageTextsResponse.json();
const pageTexts = pageTextsData.data?.[0]?.attributes;
---

<Layout
  title="Randonnées - Castagniccia Casinca"
  pageCategory="randonnee"
  pageName="liste-randonnees"
>
  <main>
    <RandonneeListing
      randonnees={randonneesData.data}
      colorData={colorData}
      pageTexts={pageTexts}
      client:load
    />
  </main>
</Layout>
