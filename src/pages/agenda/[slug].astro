---
import Layout from "../../layouts/Layout.astro";
import EventDetail from "../../components/detail/EventDetail.jsx";
import { fetchAllEvenements, fetchColorTexte } from "../../services/apiUtils.js";
import type { RootColorTexte } from "../../types/color-texte";

// Récupération des couleurs dynamiques
const colorData: RootColorTexte = await fetchColorTexte();

export async function getStaticPaths() {
  const data = await fetchAllEvenements({ populate: "*" });

  return data.data.map((event) => ({
    params: { slug: event.documentId },
    props: { event },
  }));
}

const { event } = Astro.props;
---

<Layout
  title={`${event.Nom} - Agenda`}
  pageCategory="agenda"
  pageName={event.Nom}
>
  <EventDetail event={event} colorData={colorData} client:load />
</Layout>
