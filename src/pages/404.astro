---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const suggestions = [
  { name: 'Accueil', url: '/', description: 'Retourner à la page d\'accueil' },
  { name: 'Agenda', url: '/agenda', description: 'Découvrir les événements à venir' },
  { name: 'Sites touristiques', url: '/sites', description: 'Explorer les sites incontournables' },
  { name: 'Randonnées', url: '/randonnee', description: 'Trouver des parcours de randonnée' },
  { name: 'Plages', url: '/plages', description: 'Découvrir les plus belles plages' },
  { name: 'Hébergements', url: '/sejourner', description: 'Trouver un logement' }
];
---

<Layout
  title="Page non trouvée - Erreur 404"
  description="La page que vous recherchez n'existe pas. Découvrez nos suggestions pour continuer votre exploration de la Castagniccia-Casinca."
  noindex={true}
>
  <div class="min-h-screen bg-gray-50">
    <div class="container mx-auto px-4 py-8">
      <Breadcrumb 
        items={[]} 
        currentPage="Erreur 404" 
      />
      
      <div class="max-w-4xl mx-auto text-center py-16">
        <div class="mb-8">
          <h1 class="text-6xl font-bold text-gray-300 mb-4">404</h1>
          <h2 class="text-3xl font-bold text-gray-800 mb-4">
            Page non trouvée
          </h2>
          <p class="text-xl text-gray-600 mb-8">
            Désolé, la page que vous recherchez n'existe pas ou a été déplacée.
          </p>
        </div>

        <!-- Suggestions de navigation -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          {suggestions.map(suggestion => (
            <a 
              href={suggestion.url}
              class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow border border-gray-200"
            >
              <h3 class="text-lg font-semibold text-blue-600 mb-2">
                {suggestion.name}
              </h3>
              <p class="text-gray-600 text-sm">
                {suggestion.description}
              </p>
            </a>
          ))}
        </div>

        <!-- Barre de recherche simple -->
        <div class="bg-white rounded-lg shadow-md p-8 max-w-md mx-auto">
          <h3 class="text-lg font-semibold mb-4">Rechercher sur le site</h3>
          <form action="/recherche" method="get" class="flex gap-2">
            <input 
              type="search" 
              name="q" 
              placeholder="Rechercher..."
              class="flex-1 px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              required
            />
            <button 
              type="submit"
              class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
            >
              Rechercher
            </button>
          </form>
        </div>

        <!-- Contact -->
        <div class="mt-12 text-center">
          <p class="text-gray-600">
            Vous ne trouvez pas ce que vous cherchez ? 
            <a href="/informations-pratiques" class="text-blue-600 hover:underline">
              Contactez-nous
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Animation pour l'erreur 404 */
  h1 {
    animation: float 3s ease-in-out infinite;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
</style>
