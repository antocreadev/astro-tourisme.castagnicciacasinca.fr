---
import Layout from "../../layouts/Layout.astro";
import ActiviteNautiqueListing from "../../components/listing/ActiviteNautiqueListing.jsx";
import { PUBLIC_API_URL } from "astro:env/client";
import {
  fetchAllActivitesNautiques,
  fetchColorTexte,
} from "../../services/apiUtils.js";
import type { RootActiviteNautique } from "../../types/activite-nautique";
import type { RootColorTexte } from "../../types/color-texte";
import type { RootTextePageSecondaire } from "../../types/texte-page-secondaire";

// Récupération des couleurs dynamiques
const colorData: RootColorTexte = await fetchColorTexte();

// Récupération des textes des pages secondaires
const textePageSecondaireRes = await fetch(
  `${PUBLIC_API_URL}/api/texte-page-secondaire`,
  {
    method: "GET",
    headers: {
      "Content-Type": "application/json",
    },
  }
);
const textePageSecondaireData: RootTextePageSecondaire =
  await textePageSecondaireRes.json();

// Récupérer les activités nautiques depuis l'API avec fetchAll
const activiteNautiqueData: RootActiviteNautique =
  await fetchAllActivitesNautiques({
    populate: "*",
  });

const title = "Activités Nautiques - Castagniccia Casinca";
const description =
  "Découvrez les activités nautiques de la Castagniccia Casinca";
---

<Layout
  title={title}
  description={description}
  pageCategory="activite-nautique"
  pageName="liste-activites-nautiques"
>
  <main>
    <ActiviteNautiqueListing
      activiteNautiques={activiteNautiqueData.data}
      colorData={colorData}
      pageTexts={{
        titre: textePageSecondaireData.data.titreActiviteNautique,
        description: textePageSecondaireData.data.descriptiontActiviteNautique,
      }}
      client:load
    />
  </main>
</Layout>
