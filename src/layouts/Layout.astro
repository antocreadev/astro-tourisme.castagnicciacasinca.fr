---
import Navbar from "../components/Navbar.astro";
import SEO from "../components/SEO.astro";
import PageTracker from "../components/PageTracker.jsx";
import VisiteurButton from "../components/VisiteurButton.jsx";
import { fetchColorTexte } from "../services/apiUtils.js";
import { generateCSSVariables } from "../utils/colorUtils.js";
import "../styles/global.css";

// Récupérer les couleurs dynamiques
const colorData = await fetchColorTexte();

// Récupérer les props pour le titre et autres métadonnées
export interface Props {
  title?: string;
  description?: string;
  pageCategory?: string;
  pageName?: string;
  canonical?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  keywords?: string;
}

const {
  title,
  description,
  pageCategory = "page",
  pageName,
  canonical,
  image,
  type,
  noindex,
  keywords,
} = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/logo.jpg" />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Composant SEO centralisé -->
    <SEO 
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      noindex={noindex}
      keywords={keywords}
    />
    
    <!-- Flux RSS -->
    <link rel="alternate" type="application/rss+xml" title="Agenda Castagniccia-Casinca" href="/rss.xml" />
  </head>
  <body data-page-category={pageCategory} data-page-name={pageName}>
    <Navbar />
    <div class="mt-16">
      <slot />
    </div>

    <!-- Composants React pour le tracking et le questionnaire -->
    <PageTracker pageName={pageName} pageCategory={pageCategory} client:load />
    <VisiteurButton client:load />

    <!-- Script pour le comptage des vues selon le type de page -->
    <script>
      import { initialiserTracking } from "../services/pageViewService.js";

      // Récupérer les données depuis les attributs du body
      const pageCategory =
        document.body.getAttribute("data-page-category") || "page";
      const pageName = document.body.getAttribute("data-page-name") || null;
      console.log("http://tourisme.castagnicciacasinca.fr/");
      // Détecter si c'est la page d'accueil
      const isAccueil =
        pageCategory === "Accueil" ||
        pageName === "accueil" ||
        window.location.pathname === "/" ||
        window.location.pathname === "/index" ||
        window.location.pathname === "/index.html";

      // Initialiser le tracking selon le type de page
      initialiserTracking(pageName, pageCategory, isAccueil);
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

<style is:global set:html={generateCSSVariables(colorData)}></style>
