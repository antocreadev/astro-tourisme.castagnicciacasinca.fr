---
import { type RootGlobal } from "../types/gloabal";

import { PUBLIC_API_URL } from "astro:env/client";

const data = await fetch(`${PUBLIC_API_URL}/api/global`, {
  method: "GET",
  headers: {
    "Content-Type": "application/json",
  },
});

const globalData: RootGlobal = await data.json();
---

<nav
  id="navbar"
  class="fixed top-0 left-0 w-full z-50 transition-transform duration-300 backdrop-blur-lg border-b border-white/10"
  style="background-color: var(--color-navbar-bg, rgba(255, 255, 255, 0.2)); color: var(--color-navbar-text, #000000);"
>
  <div
    class="mx-auto lg:mx-0 flex items-center justify-between px-6 py-4 lg:justify-around lg:min-w-[100vw]"
  >
    <div class="flex-shrink-0">
      <a href="/" aria-label="Retour à l'accueil">
        <img
          src={PUBLIC_API_URL +
            globalData.data.BarreDeNavigation.logo.image.url}
          alt="Logo Placeholder"
          class="absolute h-12 lg:h-14 top-1"
        />
      </a>
    </div>

    <!-- Burger button (mobile only) -->
    <button
      id="burger-menu"
      class="lg:hidden focus:outline-none"
      style="color: var(--color-navbar-text, #808080);"
      aria-controls="mobile-menu-overlay"
      aria-expanded="false"
    >
      <span class="sr-only">Ouvrir le menu</span>
      <svg
        id="burger-icon"
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16m-7 6h7"></path></svg
      >
    </button>

    <!-- Desktop nav -->
    <ul
      id="nav-links-desktop"
      class="hidden lg:flex lg:relative lg:flex-row lg:space-x-6 lg:h-auto lg:w-auto lg:bg-transparent lg:p-0 lg:text-sm font-medium"
      style="color: var(--color-navbar-text, #808080);"
    >
      {
        globalData.data.BarreDeNavigation.page_de_sections.map((page) => (
          <li class="nav-item">
            <a
              href={page.LienVersLaPage}
              class="block py-2 px-1 relative transition-colors"
              style="color: var(--color-navbar-text, #808080);"
            >
              {page.Titre}
            </a>
          </li>
        ))
      }

      <span
        id="nav-highlighter"
        class="hidden lg:block absolute bottom-0 h-0.5 bg-black transition-all duration-300 opacity-0"
      ></span>
    </ul>
  </div>
</nav>

<!-- Mobile fullscreen menu overlay (completely separate from navbar) -->
<div id="mobile-menu-overlay" class="mobile-overlay" aria-hidden="true">
  <!-- Close button top-right -->
  <button id="mobile-menu-close" class="mobile-overlay__close" aria-label="Fermer le menu">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>

  <!-- Links centered -->
  <nav class="mobile-overlay__nav">
    {
      globalData.data.BarreDeNavigation.page_de_sections.map((page) => (
        <a href={page.LienVersLaPage} class="mobile-overlay__link">
          {page.Titre}
        </a>
      ))
    }
  </nav>
</div>

<style>
  body {
    margin: 0;
    padding: 0;
    background-color: #f5f5f5;
  }

  body.menu-open {
    overflow: hidden;
  }

  #navbar {
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
  }

  #navbar.at-top {
    background-color: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(16px);
  }

  /* ===== Mobile overlay ===== */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 100000; /* Above everything: Leaflet (~400), sticky headers (50), modals (9999) */
    background: #ffffff;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    /* Hidden by default */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .mobile-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-overlay__close {
    position: absolute;
    top: 1.1rem;
    right: 1.5rem;
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: #374151;
    line-height: 0;
    border-radius: 0.5rem;
    transition: background-color 0.15s;
  }

  .mobile-overlay__close:hover {
    background-color: #f3f4f6;
  }

  .mobile-overlay__nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    width: 100%;
    padding: 0 1.5rem;
  }

  .mobile-overlay__link {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.875rem 1rem;
    font-size: 1.2rem;
    font-weight: 500;
    color: #374151;
    text-decoration: none;
    border-radius: 0.75rem;
    transition: background-color 0.15s, color 0.15s;
  }

  .mobile-overlay__link:hover,
  .mobile-overlay__link:active {
    background-color: #f3f4f6;
    color: #111827;
  }

  /* Force hide on desktop */
  @media (min-width: 1024px) {
    .mobile-overlay {
      display: none !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById("navbar");
    const burgerMenu = document.getElementById("burger-menu");
    const burgerIcon = document.getElementById("burger-icon");
    const overlay = document.getElementById("mobile-menu-overlay");
    const closeBtn = document.getElementById("mobile-menu-close");

    // --- Mobile menu ---
    const openMenu = () => {
      overlay.setAttribute("aria-hidden", "false");
      document.body.classList.add("menu-open");
      burgerMenu.setAttribute("aria-expanded", "true");
      // Keep navbar visible when menu is open
      navbar.style.transform = "translateY(0)";
    };

    const closeMenu = () => {
      overlay.setAttribute("aria-hidden", "true");
      document.body.classList.remove("menu-open");
      burgerMenu.setAttribute("aria-expanded", "false");
    };

    burgerMenu.addEventListener("click", () => {
      const isHidden = overlay.getAttribute("aria-hidden") === "true";
      if (isHidden) openMenu();
      else closeMenu();
    });

    closeBtn.addEventListener("click", closeMenu);

    // Close on link click
    overlay.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Close on Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.getAttribute("aria-hidden") === "false") {
        closeMenu();
      }
    });

    // Close on resize to desktop
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) closeMenu();
    });

    // --- Navbar scroll hide/show ---
    let lastScrollY = window.scrollY;

    window.addEventListener(
      "scroll",
      () => {
        const currentScrollY = window.scrollY;

        // Don't hide navbar when mobile menu is open
        if (overlay.getAttribute("aria-hidden") === "false" && window.innerWidth < 1024) {
          return;
        }

        if (currentScrollY > lastScrollY && currentScrollY > 50) {
          navbar.style.transform = "translateY(-100%)";
        } else {
          navbar.style.transform = "translateY(0)";
        }

        if (currentScrollY < 20) {
          navbar.classList.add("at-top");
        } else {
          navbar.classList.remove("at-top");
        }

        lastScrollY = currentScrollY;
      },
      { passive: true }
    );

    // --- Desktop highlighter ---
    const navItems = document.querySelectorAll(".nav-item");
    const highlighter = document.getElementById("nav-highlighter");

    const isDesktop = () => window.innerWidth >= 1024;

    const updateHighlighter = (item) => {
      if (!isDesktop() || !item) {
        highlighter.style.opacity = "0";
        return;
      }
      const itemRect = item.getBoundingClientRect();
      const navRect = item.parentElement.getBoundingClientRect();

      highlighter.style.width = `${itemRect.width}px`;
      highlighter.style.transform = `translateX(${itemRect.left - navRect.left}px)`;
      highlighter.style.opacity = "1";
    };

    const hideHighlighter = () => {
      const activeItem = document.querySelector(".nav-item.active");
      if (activeItem && isDesktop()) {
        updateHighlighter(activeItem);
      } else {
        highlighter.style.opacity = "0";
      }
    };

    navItems.forEach((item) => {
      item.addEventListener("mouseenter", () => updateHighlighter(item));
      item.addEventListener("mouseleave", hideHighlighter);
    });

    window.addEventListener("resize", hideHighlighter);

    const activeItem = document.querySelector(".nav-item.active");
    updateHighlighter(activeItem);
  });
</script>
