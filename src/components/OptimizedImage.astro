---
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
  sizes?: string;
  quality?: number;
  format?: 'webp' | 'avif' | 'jpeg' | 'png';
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  class: className = '',
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw',
  quality = 80,
  format = 'webp'
} = Astro.props;

// Génération des URLs pour différentes tailles (responsive)
const generateSrcSet = (baseSrc, format) => {
  const sizes = [480, 768, 1024, 1280, 1920];
  return sizes.map(size => {
    // Pour l'instant, on utilise l'image originale
    // Dans une vraie implementation, on générerait différentes tailles
    return `${baseSrc} ${size}w`;
  }).join(', ');
};

const srcSet = generateSrcSet(src, format);
---

<picture class={className}>
  <!-- Version WebP pour les navigateurs compatibles -->
  <source 
    srcset={srcSet} 
    sizes={sizes}
    type="image/webp"
  />
  
  <!-- Fallback JPEG -->
  <img 
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    class={className}
    sizes={sizes}
    style={`aspect-ratio: ${width && height ? `${width}/${height}` : 'auto'};`}
  />
</picture>

<style>
  picture img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>
